<div class="max-w-2xl mx-auto flex flex-col gap-3">
  <div class="flex items-center justify-between gap-2">
    <a href="/quota" class="btn btn-ghost btn-sm">← 返回列表</a>
    {{#ok}}
    {{#statusOk}}<span class="badge badge-success badge-sm">正常</span>{{/statusOk}}
    {{^statusOk}}<span class="badge badge-error badge-sm">停用</span>{{/statusOk}}
    {{/ok}}
  </div>

  {{^ok}}
  <div class="alert alert-error">
    <div>
      <div class="font-semibold">{{label}}</div>
      <div class="text-sm">{{info}}</div>
    </div>
  </div>
  {{/ok}}

  {{#ok}}
  <div class="card bg-base-100 shadow">
    <div class="card-body gap-3 p-4">
      <div class="min-w-0">
        <div class="font-bold text-lg truncate">{{label}}</div>
        <div class="text-sm opacity-50 font-mono">{{masked}}</div>
      </div>

      <div class="flex items-center gap-4">
        <div class="relative shrink-0" style="width:6.5rem;height:6.5rem;">
          <div class="w-full h-full rounded-full" style="background:conic-gradient(#3b82f6 0 {{pctNum}}%, var(--color-base-300,#d1d5db) {{pctNum}}% 100%);"></div>
          <div class="absolute rounded-full bg-base-100 flex flex-col items-center justify-center" style="inset:0.6rem;">
            <span class="text-xl font-bold" style="color:#3b82f6;">{{remainShort}}</span>
            <span class="text-xs opacity-60">剩余</span>
          </div>
        </div>
        <div class="flex-1 flex flex-col gap-1 text-sm">
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#3b82f6;"></span>剩余</span>
            <span class="font-semibold">{{remainFull}} <span class="opacity-50">({{pctNum}}%)</span></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-base-300"></span>已用</span>
            <span class="font-semibold">{{usedFull}} <span class="opacity-50">({{usagePct}}%)</span></span>
          </div>
          <div class="border-t border-base-200 my-0.5"></div>
          <div class="flex items-center justify-between">
            <span class="opacity-60">总额度</span>
            <span class="font-semibold">{{totalFull}}</span>
          </div>
        </div>
      </div>

      <div class="rounded-lg bg-base-200/60 px-3 py-2">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-sm opacity-70">服务周期</span>
          <div class="flex items-baseline gap-1 text-sm">
            {{#isExpired}}<span class="text-error font-bold">已到期</span>{{/isExpired}}
            {{^isExpired}}
            {{#remainText}}<span class="font-bold text-base{{#isUrgent}} text-error{{/isUrgent}}">{{remainText}}</span><span class="opacity-60">后到期</span>{{/remainText}}
            {{/isExpired}}
            {{#daysUnknown}}<span class="opacity-50">—</span>{{/daysUnknown}}
          </div>
        </div>
        <div class="relative h-2.5 rounded-full bg-base-300 overflow-hidden">
          <div class="absolute inset-y-0 left-0 rounded-full" style="width:{{timelinePct}}%;background:{{timelineColor}};"></div>
        </div>
        <div class="flex justify-between mt-1.5 text-sm font-mono">
          <span class="opacity-60">{{createdFmt}}</span>
          <span class="font-semibold">{{expiredFmt}}</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        <div class="flex items-center justify-between gap-2">
          <span class="opacity-60 shrink-0">套餐</span>
          <span class="font-medium truncate">{{quotaName}}</span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="opacity-60 shrink-0">套餐标识</span>
          <span class="font-medium truncate">{{keyFlag}}</span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="opacity-60 shrink-0">分组</span>
          <span class="font-mono truncate">{{group}}</span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="opacity-60 shrink-0">上游 ID</span>
          <span class="font-mono truncate">{{upstreamId}}</span>
        </div>
      </div>

      <button class="btn btn-outline btn-sm" onclick="navigator.clipboard.writeText(this.dataset.key);const t=this.textContent;this.textContent='已复制';setTimeout(()=>this.textContent=t,800)" data-key="{{rawKey}}">复制完整 Key</button>
    </div>
  </div>
  {{/ok}}
</div>
