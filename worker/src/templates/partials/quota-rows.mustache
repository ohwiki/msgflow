{{^hasResults}}
<div class="alert alert-warning">没有可查询的 key</div>
{{/hasResults}}
{{#hasResults}}
<div class="flex flex-col gap-2">
  {{#results}}
  {{#ok}}
  <div class="card bg-base-100 shadow">
    <div class="card-body gap-1.5 px-4 py-3">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0 flex items-baseline gap-2">
          <span class="font-bold truncate">{{label}}</span>
          <span class="text-xs opacity-50 font-mono shrink-0">{{masked}}</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          {{#statusOk}}<span class="badge badge-success badge-sm">正常</span>{{/statusOk}}
          {{^statusOk}}<span class="badge badge-error badge-sm">停用</span>{{/statusOk}}
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex-1 min-w-0 flex items-center gap-2">
          <div class="relative h-2 flex-1 rounded-full bg-base-300 overflow-hidden">
            <div class="absolute inset-y-0 left-0 rounded-full" style="width:{{pctNum}}%;background:{{pctColor}};"></div>
          </div>
          <span class="text-sm font-semibold shrink-0" style="color:{{pctColor}};">{{#pctLabel}}<span class="text-xs opacity-60 font-normal">{{pctLabel}} </span>{{/pctLabel}}{{pctNum}}%</span>
        </div>
        <div class="text-sm shrink-0">
          {{#isExpired}}<span class="text-error font-bold">已到期</span>{{/isExpired}}
          {{^isExpired}}
          {{#remainText}}<span class="font-semibold{{#isUrgent}} text-error{{/isUrgent}}">{{remainText}}</span>{{/remainText}}
          {{/isExpired}}
          {{#daysUnknown}}<span class="opacity-50">—</span>{{/daysUnknown}}
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button class="btn btn-ghost btn-xs" onclick="navigator.clipboard.writeText(this.dataset.key);const t=this.textContent;this.textContent='已复制';setTimeout(()=>this.textContent=t,800)" data-key="{{rawKey}}" title="复制完整 Key">复制</button>
          <a class="btn btn-outline btn-xs" href="/quota/{{provider}}/{{id}}">详情</a>
        </div>
      </div>
    </div>
  </div>
  {{/ok}}
  {{^ok}}
  <div class="card bg-base-100 shadow border border-error/40">
    <div class="card-body gap-1 px-4 py-3">
      <div class="flex items-center justify-between gap-2">
        <span class="font-semibold truncate">{{label}}</span>
        <span class="text-xs opacity-50 font-mono shrink-0">{{masked}}</span>
      </div>
      <div class="text-error text-sm">{{info}}</div>
    </div>
  </div>
  {{/ok}}
  {{/results}}
</div>
{{/hasResults}}
