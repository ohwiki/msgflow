<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>公众号排版器 — MsgFlow</title>
<link href="{{cdnDaisyui}}" rel="stylesheet" type="text/css"/>
<link href="{{cdnDaisyuiThemes}}" rel="stylesheet" type="text/css"/>
<script src="{{cdnTailwind}}"></script>
</head>
<body class="h-screen flex flex-col bg-base-200 overflow-hidden">
<div class="flex items-center gap-4 px-4 py-2 bg-base-100 border-b border-base-300 shadow-sm flex-wrap">
  <h1 class="text-base font-bold text-base-content">📝 公众号排版器</h1>
  <div class="w-px h-6 bg-base-300"></div>
  <div class="flex items-center gap-2 flex-wrap">
    <select id="theme" class="select select-sm select-bordered w-fit">
      {{#themes}}
      <option value="{{id}}" data-grid="{{defaultGrid}}"{{#isDefault}} selected{{/isDefault}}>{{name}}{{#isDefault}}（默认）{{/isDefault}}</option>
      {{/themes}}
    </select>
    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" id="enableAI" class="checkbox checkbox-sm checkbox-primary">
      <span>✨ 启用 AI 排版</span>
    </label>
    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" id="enableGuide" class="checkbox checkbox-sm checkbox-primary">
      <span>引导语</span>
    </label>
    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" id="enableSignature" class="checkbox checkbox-sm checkbox-primary">
      <span>署名</span>
    </label>
    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" id="enableFootnotes" class="checkbox checkbox-sm checkbox-primary" checked>
      <span>链接转脚注</span>
    </label>
    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" id="enableTitle" class="checkbox checkbox-sm checkbox-primary">
      <span>渲染标题</span>
    </label>
    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" id="enableGrid" class="checkbox checkbox-sm checkbox-primary">
      <span>网格背景</span>
    </label>
  </div>
  <div class="w-px h-6 bg-base-300"></div>
  <div class="flex items-center gap-2">
    <select id="fontSize" class="select select-sm select-bordered w-fit" title="正文字号">
      <option value="14">14px</option>
      <option value="15" selected>15px</option>
      <option value="16">16px</option>
      <option value="17">17px</option>
      <option value="18">18px</option>
    </select>
    <select id="lineHeight" class="select select-sm select-bordered w-fit" title="行高">
      <option value="1.6">行高1.6</option>
      <option value="1.75">行高1.75</option>
      <option value="1.8" selected>行高1.8</option>
      <option value="2.0">行高2.0</option>
      <option value="2.2">行高2.2</option>
    </select>
  </div>
  <div class="flex items-center gap-2 ml-auto">
    <button class="btn btn-sm btn-error" onclick="runFormat()">排版</button>
    <button class="btn btn-sm btn-success" id="copyBtn" onclick="doCopy()" disabled>复制到公众号</button>
  </div>
  <div class="w-px h-6 bg-base-300"></div>
  <div class="flex items-center gap-3 px-3 py-1 border border-base-300 rounded-lg bg-base-200" title="直接选择各类文字字号（不重新排版）">
    <span class="flex items-center gap-1"><span class="text-xs text-base-content/60">正文</span>
      <select class="select select-xs select-bordered w-fit" id="fsSelBody" onchange="setFontSize('body',this.value)">
        <option value="">默认(15)</option>
        <option value="12">12px</option><option value="13">13px</option><option value="14">14px</option>
        <option value="15">15px</option><option value="16">16px</option><option value="17">17px</option>
        <option value="18">18px</option><option value="19">19px</option><option value="20">20px</option>
      </select>
    </span>
    <span class="flex items-center gap-1"><span class="text-xs text-base-content/60">标题</span>
      <select class="select select-xs select-bordered w-fit" id="fsSelTitle" onchange="setFontSize('title',this.value)">
        <option value="">默认(22)</option>
        <option value="18">18px</option><option value="20">20px</option><option value="22">22px</option>
        <option value="24">24px</option><option value="26">26px</option><option value="28">28px</option>
        <option value="30">30px</option><option value="32">32px</option>
      </select>
    </span>
    <span class="flex items-center gap-1"><span class="text-xs text-base-content/60">二级标题</span>
      <select class="select select-xs select-bordered w-fit" id="fsSelH2" onchange="setFontSize('h2',this.value)">
        <option value="">默认(18)</option>
        <option value="14">14px</option><option value="15">15px</option><option value="16">16px</option>
        <option value="17">17px</option><option value="18">18px</option><option value="20">20px</option>
        <option value="22">22px</option><option value="24">24px</option>
      </select>
    </span>
    <button class="btn btn-ghost btn-xs" onclick="resetFontSize()">重置</button>
  </div>
</div>
<div class="flex flex-1 overflow-hidden">
  <div class="w-56 min-w-40 max-w-sm flex flex-col border-r border-base-300 bg-base-100 resize-x overflow-hidden" id="historyPane">
    <div class="flex items-center justify-between px-4 py-2 text-xs font-semibold text-base-content/60 bg-base-200 border-b border-base-300 tracking-wider">
      <span>历史记录</span>
      <span class="font-normal text-base-content/40" id="historyCount"></span>
    </div>
    <div class="flex gap-1.5 px-3 py-2 border-b border-base-300">
      <button class="btn btn-sm btn-outline btn-dash flex-1" id="btnNewFolder" onclick="showInlineInput('folder')">📁+</button>
      <button class="btn btn-sm btn-outline btn-dash flex-1" id="btnNewDoc" onclick="showInlineInput('doc')">📄+</button>
    </div>
    <div class="flex gap-1 px-3 py-1.5 border-b border-base-300 bg-base-200 items-center hidden" id="inlineInputBox">
      <select id="inlineFolderSelect" class="select select-xs select-bordered hidden max-w-20"></select>
      <input type="text" id="inlineInput" class="input input-xs input-bordered flex-1 min-w-0" placeholder="" onkeydown="if(event.key==='Enter')confirmInlineInput();if(event.key==='Escape')hideInlineInput();">
      <button class="btn btn-square btn-xs btn-primary" onclick="confirmInlineInput()">✓</button>
      <button class="btn btn-square btn-xs btn-ghost" onclick="hideInlineInput()">×</button>
    </div>
    <div class="flex-1 overflow-y-auto" id="historyList">
      <p class="p-4 text-base-content/40 text-xs">加载中...</p>
    </div>
  </div>
  <div class="w-1/2 min-w-80 max-w-[75%] flex flex-col border-r border-base-300 resize-x overflow-hidden">
    <div class="flex items-center justify-between px-4 py-2 text-xs font-semibold text-base-content/60 bg-base-200 border-b border-base-300 tracking-wider">
      <span>MARKDOWN 输入</span>
      <span class="font-normal text-base-content/40">Ctrl+Enter 排版</span>
    </div>
    <textarea id="md" class="textarea flex-1 w-full rounded-none border-0 font-mono text-[13px] leading-relaxed bg-base-100 focus:outline-none resize-none p-4" placeholder="在此粘贴 Markdown 文章内容...&#10;&#10;支持：标题、段落、加粗、引用、代码块、图片、列表等"></textarea>
  </div>
  <div class="flex-1 flex flex-col bg-base-100">
    <div role="tablist" class="tabs tabs-border">
      <button role="tab" class="tab tab-active" id="tabBasic" onclick="switchTab('basic')">
        普通排版 <span class="badge badge-sm ml-1.5" id="badgeBasic"></span>
      </button>
      <button role="tab" class="tab tab-disabled" id="tabAI" onclick="switchTab('ai')">
        ✨ AI 排版 <span class="badge badge-sm ml-1.5" id="badgeAI">未启用</span>
      </button>
    </div>
    <div class="flex-1 relative">
      <iframe id="previewBasic" class="absolute inset-0 w-full h-full border-0 bg-white"></iframe>
      <iframe id="previewAI" class="absolute inset-0 w-full h-full border-0 bg-white invisible"></iframe>
    </div>
  </div>
</div>
<div class="flex gap-4 items-center flex-wrap px-4 py-2 text-xs text-base-content/60 bg-base-200 border-t border-base-300" id="status">
  <span>就绪 — 粘贴 Markdown 后点击「排版」。勾选「✨ 启用 AI 排版」可对比AI增强效果</span>
</div>
<script>{{{script}}}</script>
</body>
</html>
