{
  "name": "msgflow-worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build:client": "esbuild src/client/format-editor.ts src/client/rss-reader.ts --bundle --minify --format=iife --outdir=src/templates --out-extension:.js=.client.js",
    "dev": "pnpm run build:client && wrangler dev",
    "predeploy": "pnpm run build:client",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@ouraihub/llm": "0.2.1",
    "fast-xml-parser": "^5.9.3",
    "marked": "18.0.4",
    "mustache": "4.2.0",
    "node-html-markdown": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.9.0",
    "@cloudflare/workers-types": "4.20250514.0",
    "@types/mustache": "4.2.5",
    "typescript": "5.8.3",
    "vitest": "3.1.3",
    "wrangler": "4.88.0"
  }
}
